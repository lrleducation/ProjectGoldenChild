# Public URL
PUBLIC_BASE_URL=https://www.projectgoldenchild.org

# Production database (required in production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin authentication (required in production)
# Generate users with: npm run admin:user -- adam@example.com "strong password" "Adam" director
ADMIN_USERS_JSON=[]
SESSION_SECRET=

# Email notifications (optional but recommended)
RESEND_API_KEY=
FROM_EMAIL=Project Golden Child <website@your-domain.org>
NOTIFICATION_EMAIL=

# Local-only override; server.mjs sets this automatically
PGC_LOCAL_DEV=0
