{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/our-story",
      "destination": "/our-story.html"
    },
    {
      "source": "/harpers-heroes",
      "destination": "/heroes.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/go-gold",
      "destination": "/go-gold.html"
    },
    {
      "source": "/refer",
      "destination": "/refer.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/admin-event-review-ai.js": {
      "maxDuration": 60
    },
    "api/admin-event-transcribe.js": {
      "maxDuration": 60
    },
    "api/admin-communications.js": {
      "maxDuration": 60
    },
    "api/admin-appointments.js": {
      "maxDuration": 60
    },
    "api/appointment-reminders.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/appointment-reminders",
      "schedule": "15 6 * * *"
    }
  ]
}
